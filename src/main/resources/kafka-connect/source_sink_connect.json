//POST localhost:8083/connectors
{
"name": "my-sink-es-connect",
"config": {
"connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
"connection.url": "http://host.docker.internal:9200",
"type.name": "_doc",
"topics": "user",
"key.ignore": "false",  // ✔ key를 Elasticsearch _id로 사용
"schema.ignore": "true",
"batch.size": "1000",
"max.in.flight.requests": "5",
"tasks.max": "1",

"value.converter": "org.apache.kafka.connect.json.JsonConverter",
"value.converter.schemas.enable": "false",

"key.converter": "org.apache.kafka.connect.json.JsonConverter",     // ✔ key도 JSON 형식이라고 명시
"key.converter.schemas.enable": "false",

"transforms": "unwrap,keyExtract",                                  // ✔ unwrap + key 필드 추출
"transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
"transforms.unwrap.drop.tombstones": "false",
"transforms.keyExtract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
"transforms.keyExtract.field": "id"                                 // ✔ key에서 id만 사용 (예: "id": 3)
}
}

//POST localhost:8083/connectors
{
"name": "debezium-mysql-source",
"config": {
"connector.class": "io.debezium.connector.mysql.MySqlConnector",
"tasks.max": "1",
"database.hostname": "host.docker.internal",
"database.port": "3306",
"database.user": "root",
"database.password": "test",
"database.server.id": "223344",  // 고유한 server-id
"database.server.name": "dbserver1",  // 카프카 토픽에 사용될 접두사
"database.include.list": "test",      // 사용할 DB
"table.include.list": "test.user",    // 사용할 테이블
"schema.history.internal.kafka.topic": "schema-changes.test",
"schema.history.internal.kafka.bootstrap.servers": "host.docker.internal:9092",
"include.schema.changes": "true",
"snapshot.mode": "initial",  // 초기 스냅샷 모드
"value.converter": "org.apache.kafka.connect.json.JsonConverter",
"value.converter.schemas.enable": "false",
"topic.prefix": "dbserver1", // 카프카 토픽 접두사
"transforms": "renameTopic, unwrap",
"transforms.renameTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
"transforms.renameTopic.regex": "dbserver1.test.user",  // 토픽 이름 변경
"transforms.renameTopic.replacement": "user",
"connection.timezone": "UTC",
"key.converter": "org.apache.kafka.connect.json.JsonConverter",
"transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
"transforms.unwrap.drop.tombstones": "false"
}
}

// 시놀로지
{
  "name": "debezium-mysql-source",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "transforms": "renameTopic,unwrap",
    "include.schema.changes": "true",
    "topic.prefix": "dbserver1",
    "schema.history.internal.kafka.bootstrap.servers": "192.168.0.21:9092",
    "schema.history.internal.kafka.topic": "schema-changes.test",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "database.user": "root",
    "database.server.id": "223344",
    "database.server.name": "dbserver1",
    "database.hostname": "192.168.0.21",
    "database.port": "5500",  // MySQL 서버 포트를 명시적으로 설정
    "database.password": "root",
    "value.converter.schemas.enable": "false",
    "key.converter.schemas.enable": "true",
    "name": "debezium-mysql-source",
    "transforms.renameTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.renameTopic.regex": "dbserver1\\.test\\.(.*)",
    "transforms.renameTopic.replacement": "$1",
    "table.include.list": "test.user",
    "database.include.list": "test",
    "snapshot.mode": "initial"
  }
}

// 시놀로지
{
  "name": "my-sink-es-connect",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
    "connection.url": "http://192.168.0.21:9200",
    "type.name": "_doc",
    "topics": "user",
    "key.ignore": "false",  // key를 Elasticsearch _id로 사용
    "behavior.on.null.values": "delete",           // 삭제 이벤트를 ES에 delete로 반영

    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter"  // key를 String으로 처리
  }
}